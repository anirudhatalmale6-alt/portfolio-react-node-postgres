# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgres://user:password@host:5432/portfolio
# Managed Postgres (Render/Neon/Supabase) needs TLS - either keep ?sslmode=require
# on the URL above or set PGSSL=true here.
PGSSL=false

# Signing key for the admin session cookie. At least 24 characters, random.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Comma-separated list of origins allowed to call the API with cookies.
CORS_ORIGIN=http://localhost:5173

PORT=4000
NODE_ENV=development
